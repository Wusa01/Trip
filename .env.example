# انسخ هذا الملف باسم .env وضع القيم الحقيقية فيه — لا تشارك .env مع أحد

# مفتاح أمان Flask (غيّره لأي نص عشوائي طويل قبل النشر الفعلي)
SECRET_KEY=change-this-secret-key

# إعدادات بريد Gmail لإرسال رموز التفعيل والنسخ الاحتياطية
# راجع README لطريقة إنشاء كلمة مرور التطبيقات (App Password)
MAIL_USERNAME=your-address@gmail.com
MAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
